# character to find 
# 5 letters `a` found in `name`

count = 0
text = input("insert your text:")
text_find = input(f"character to find find in {text}:")
for letter in text:
    if letter == text_find:
        count += 1
print(f"{count} letters {text_find} found in {text}")


pw = input("password:")
lenght_check = True
a_at_check = True
alpha_check = True
digit_check = True

if lenght_check:
    if len(pw) < 8:
        print("Too weak: password must be at least 8 characters")
        

if a_at_check:
    if "@" not in pw:
        print("Include '@' in the password")
        

if alpha_check:
    if not any(c.isalpha() for c in pw):
        print("Include at least one letter")
        

if digit_check:
    if not any(c.isdigit() for c in pw):
        print("Include at least one digit")
