bucket = [
    [1, 50, 2.50],
    [51, 100, 3.00],
    [101, 200, 3.50],
    [200, None, 4.00]
]

x = 220
real_total = 0

for first,end,price in bucket:
    if x <= 0:
        break
    if end is None:
        final=x
        total+= final * price
        print(f"{final}{price}")
        break
    final=min(x,end-first+1)
    total=final*price
    real_total+=total
    x-=final
    print(f"{final}{price}")
print(f"{total}")
